@startuml context-diagram-dataspace
'context diagram
caption Context Diagram: Interactions between the EDDIE System and its environment

skinparam usecase {
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle {
  BorderColor black
  BackgroundColor transparent
}
skinparam collections {
  BorderColor black
  BackgroundColor white
}
skinparam actorStyle awesome
skinparam actor {
  BorderColor black
  BackgroundColor white
}

rectangle "Gaia-X\nFramework" as gaiaX
collections "External Energy Data Space\n(e.g. OneNet, Omega-X)" as dataSpaces
usecase "\n\nEDDIE\nSystem\n\n" as eddie
collections "Metering\nDevice" as smartMeter
collections "Regional Energy\nDatahub" as regionalData
collections "EP Website" as website
collections "Service" as service

actor "Eligible\nParties" as ep
actor "Customers" as customer

gaiaX -down-> eddie : Offers\ncompliance\nservices
gaiaX -down-> dataSpaces : Offers\ncompliance\nservices

eddie <-right-> dataSpaces : Data exchange\nbased on IDSA

service -right-> eddie : Accesses\ncustomer data
eddie -down-> regionalData : Accesses\ncustomer\nhistorical data
eddie -down-> smartMeter : Accesses\ncustomer\nreal-time data
website -right-> eddie : Forwards\ncustomer\ninformation
smartMeter -[hidden] regionalData : \t\t\t
website -[hidden] gaiaX : \t\t\t\t\t\t


ep -right-> service : Provide
ep -up-> website : Provide

customer -right-> website : Submit\ncustomer\ninformation

@enduml