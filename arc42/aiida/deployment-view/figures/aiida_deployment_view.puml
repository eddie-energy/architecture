@startuml aiida_deployment_view
'component diagram

' skinparam linetype ortho

skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam node{
  BorderColor black
  BackgroundColor white
}
skinparam rectangle{
  ' BorderColor transparent
  BackgroundColor transparent
  FontColor black
}

rectangle "AIIDA System" {
  node "Eligible Party Infrastructure"  as epInfra{
    rectangle "EDDIE Framework" {
      artifact "AIIDA Regional\nConnector" as regcon
    }
    artifact "EMQX \nMQTT Broker" as broker
    artifact "EMQX \nIAM DB" as emqxiam

    broker -right- emqxiam : SQL
    regcon -down- broker : MQTT
  }

  node "Smartphone" as smartphone{
    artifact "AIIDA Smartphone App" as app

  }
  node "In-house Device" as aiida {
    artifact "AIIDA Embedded App" as embapp
    artifact "NanoMQ \nMQTT Broker" as nano
    artifact "TimescaleDB" as db

    embapp -down- nano : MQTT
    embapp -down- db : SQL
    db -[hidden]right- nano
  }

  embapp -up- app : DNS Service\nDiscovery
  embapp -right- broker : MQTT

  ' frame "Device Austria" as device2
  ' frame "Device France" as device3
node "Adapter Device" as adapterDevice
}
node "Smart Meter" as smartmeter

adapterDevice -left- embapp :  Wired Connection\ne.g., USB
adapterDevice -left- nano : MQTT

smartmeter -up- adapterDevice : Wired Connection\ne.g., RJ12


' frame "Enedis" as enedis
' frame "Smart Meter" as smartmeter2

' device1 -left- smartmeter1:\n\nPhysical\ninterfaces
' device2 -left- smartmeter2:\n\nPhysical\ninterfaces
' device3 -left- enedis:\nTIC\n(2-wire)



' embapp -right- device1:USB
' embapp -right- device3:Modbus TCP
' nano -right- device2:MQTT
' device1 -[hidden]down- device2
' device2 -[hidden]down- device3
' epInfra -[hidden]right- aiida
' enedis -[hidden]left-device3





@enduml