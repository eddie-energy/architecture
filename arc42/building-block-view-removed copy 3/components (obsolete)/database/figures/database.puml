@startuml database
'component diagram
caption Component Diagram: High-level view of the Database

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam component{
  BorderColor black
  BackgroundColor transparent
}
skinparam collections{
  BorderColor black
  BackgroundColor white
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}
' component "Service/Data\nMarketplace" as marketplace
node "Eligible Party Infrastructure"  as epInfra{
  component "EDDIE Framework" as eddie {
    component "Interoperable Communication" as comm {
      collections "Regional Connector\n" as regCon
      component "AIIDA\nConnector" as regConAIIDA
    }
    database "Database\n" as database
    component "Admin\nConsole" as adminconsole

    database -down- regCon
    database -down- regConAIIDA
    database -right- adminconsole
  }

}








@enduml