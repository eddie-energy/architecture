@startuml eddie-framework-permission-request

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Customer" as customer
actor "Eligible Party (EP)" as ep

box "EP Infrastructure" #transparent
  participant "EP Website" as epApp
end box

box "EDDIE Framework" #transparent
  participant "EDDIE Popup" as popup
  participant "EDDIE Core" as core
  participant "Region Connector" as rc
end box

== Setup ==
ep -> epApp : Create Data Need\nvia API or Admin Console
ep -> epApp : Embed EDDIE Popup\nand configure with Data Need

== Permission Request ==
customer -> epApp : Click EDDIE Popup
epApp -> popup : Open Permission Dialog
activate popup

' --- Detailed permission interaction ---
popup -> core : Fetch Data Need
popup -> core : Fetch Permission Administrators
popup -> core : Fetch RC Metadata
customer -> popup : Confirm Data Need
customer -> popup : Select Country and PA
popup -> rc : Fetch RC Element
customer -> popup : Interact with RC Element
note over customer, rc
  Interaction varies by RC element
  (e.g., metering point, access token)
end note
popup -> rc : Send Permission Request\nbased on user interaction
popup -> core : Subscribe to Permission Status
' --- End detailed interaction ---

core -> rc : Forward Permission Request
rc -> customer : Show Consent Portal
customer -> rc : Accept Request
rc -->> core : Consent Accepted
core -->> popup : Show confirmation
popup -->> customer : Confirmation / Success page
deactivate popup

== Data Access ==
ep -> core : Retrieve Data
core -> rc : Request Validated Data
rc -->> ep : Provide Data

@enduml
