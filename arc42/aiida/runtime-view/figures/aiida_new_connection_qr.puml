@startuml aiida_new_connection_qr
'sequence diagram
caption Establish a new connection via QR-Code Scan

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Customer" as user
box "EP Infrastructure" #transparent
  participant "EP Website" as website
  participant "EMQX IAM \nDatabase" as database
end box
box "\tAIIDA Network\t\t"  #transparent
  participant "Smartphone" as smartphone  
    box "AIIDA" #transparent
    participant "AIIDA Regional \nConnector" as connector
       box "AIIDA Embedded App" #transparent
      participant "AIIDA Backend" as backend
    end box
  end box


user -> website : AIIDA connect
activate website

  website -->> user : show (QR-Code/ Token)
deactivate website


  user -> smartphone : scan QR Code, add new permission

    smartphone -> backend : add new permission
   

    backend -->> connector : establish connection

    connector -> database : create user



@enduml