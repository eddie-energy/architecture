@startuml eddie-framework-terminate-permission

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Eligible Party" as ep

box "EP Infrastructure" #transparent
  participant "EP Website" as epInterface
end box

box "EDDIE Framework" #transparent
  participant "EDDIE Core" as eddie
  participant "Region Connector" as rc
  participant "Database" as db
  participant "Permission Administrator" as pa
end box

== Termination Request ==
ep -> epInterface : Initiate permission termination\n(via API or Admin Console)
epInterface -> eddie : Send termination request
activate eddie
eddie -> rc : Route termination request\nto correct Region Connector
rc -> db : Update permission status\nto TERMINATED
rc -> pa : Terminate permission request\n(if possible)
rc -> db : Delete credentials\n(if needed)
rc -->> eddie : Confirm termination
eddie -->> epInterface : Acknowledge termination\n(success or failure)
deactivate eddie

@enduml
