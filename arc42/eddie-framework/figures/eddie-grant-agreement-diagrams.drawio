        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-26" value="Proceed to DSO Portal..." style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.buttons.button;strokeColor=#666666;fontColor=#ffffff;mainText=;buttonStyle=round;fontSize=17;fontStyle=1;fillColor=#008cff;whiteSpace=wrap;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="870" y="1510" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-27" value="&lt;b&gt;IMPORTANT:&lt;/b&gt; In Austria, the service requesting consent for data access needs to generate a Consent Identifier up front and send a request to the DSO. The customer - you - then needs to provide this ConsentID in the DSO&#39;s customer portal." style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;spacingTop=10;spacingLeft=10;spacingBottom=10;spacingRight=10;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="200" y="1297" width="890" height="100" as="geometry" />
        </mxCell>
