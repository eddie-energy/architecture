          <mxGeometry x="3460" y="3160" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-138" value="While some RCs will immediately send data, there is little benefit in us informing the end user." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3680" y="3080" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-139" value="EDA&amp;nbsp;🇦🇹" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
