        <mxCell id="RdzAWC6_sVqKkpMurNL4-122" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="3210" y="3250" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-123" value="&lt;div&gt;This is likely caused by one of the following:&lt;/div&gt;1. There is a network issue on the server.&lt;div&gt;2. The PA is unreachable (Ponton down for EDA).&lt;/div&gt;&lt;div&gt;3. The RC is configured incorrectly.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="2990" y="3370" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-124" value="The end user likely skipped the browser input validation." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="2717.5" y="3410" width="185" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-125" value="The user did not react to the request in a timely manner. EP configures duration." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3430" y="3270" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-126" value="&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The request was faulty despite our validation. Either we were unable to validate a user input, the PA decided that they cannot handle the request, or the PA API changed.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Sent immediately without user interaction.&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3430" y="3330" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-127" value="The user rejected the request at the PA portal." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3430" y="3210" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-128" value="UNFULFILLABLE" style="whiteSpace=wrap;html=1;fillColor=#FFCCCC;" parent="1" vertex="1">
          <mxGeometry x="3530" y="3160" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-129" value="Some RCs will send this state almost immediately and we can inform the end user accordingly." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3680" y="3150" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-130" value="Request was validated by us and can be sent to the PA." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="3027.5" y="3190" width="185" height="50" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-131" value="For RCs implementing callback pages (Enedis, Mijn, Green Button) the status will not change from VALIDATED to SENT_TO_PA immediately. The status changes once the user lands on the callback page." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="2580" y="3160" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-132" value="Request are CREATED when they pass our browser and API validation." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="2430" y="3260" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-133" value="FULFILLED" style="whiteSpace=wrap;html=1;fillColor=#CCFFCC;" parent="1" vertex="1">
          <mxGeometry x="3530" y="3100" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="RdzAWC6_sVqKkpMurNL4-134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="RdzAWC6_sVqKkpMurNL4-117" target="RdzAWC6_sVqKkpMurNL4-137" edge="1">
