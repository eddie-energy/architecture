@startuml component-diagram-level-3-consent-facade
'component diagram
caption Component Diagram: Level 3 view with focus on the Consent Facade

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam component{
  BorderColor black
  BackgroundColor transparent
}
skinparam collections{
  BorderColor black
  BackgroundColor white
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

node "Eligible Party Infrastructure"  as epInfra{
  component "User Interface \n(Website or App)" as ui
  component "EDDIE Framework" as eddie {
    component "Consent Facade" as consentFacade {
      component "Micro frontend -\nAustria" as regConAu
      component "Micro frontend -\nFrance" as regConFr
      collections "Micro frontend -\nOther" as regConOt

      ' regConFr -up- regConAu
      ' regConFr -down- regConOt
    }
  component "Interoperable Communication" as comm

  consentFacade --down- comm 
  }  
  ui -down(0- consentFacade
}





@enduml