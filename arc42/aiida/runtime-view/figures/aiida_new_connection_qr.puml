@startuml aiida_new_connection_qr
'sequence diagram

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Customer" as user
box "EP Infrastructure" #transparent
participant "EP Website" as website
participant "EMQX IAM \nDatabase" as database
end box
box "\tAIIDA\t\t"  #transparent
participant "AIIDA Regional \nConnector" as connector
box "\t\tAIIDA Embedded App\t\t"  #transparent
participant "AIIDA \nSmartphone App" as frontend
participant "AIIDA Backend" as backend
end box
end box

user -> website : connect AIIDA
activate website
website -> connector : request QR code/token
activate connector
connector -->> website : QR code/token
deactivate connector
website -->> user : QR-Code/ Token
deactivate website

user -> frontend : scan QR Code, add new permission
frontend -> backend : token \npermission
backend -> connector : establish connection via MQTT
connector -> database : create user

@enduml