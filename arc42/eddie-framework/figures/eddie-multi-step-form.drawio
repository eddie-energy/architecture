        <mxCell id="cABAZdG-4c3w-i0kzepM-1270" value="Invalid configuration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=default;align=left;spacingLeft=30;verticalAlign=middle;fontStyle=1" parent="cABAZdG-4c3w-i0kzepM-1269" vertex="1">
          <mxGeometry x="-10" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cABAZdG-4c3w-i0kzepM-1271" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="cABAZdG-4c3w-i0kzepM-1269" vertex="1">
          <mxGeometry x="1.428571428571427" y="7.519999999999982" width="15" height="14.97" as="geometry" />
        </mxCell>
        <mxCell id="cABAZdG-4c3w-i0kzepM-1272" value="&lt;h4 style=&quot;margin-top: 0px;&quot;&gt;Possible errors&lt;/h4&gt;&lt;p&gt;&lt;/p&gt;&lt;ul style=&quot;padding-left: 20px;&quot;&gt;&lt;li&gt;Fetch fails&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Network issue on the client&lt;/li&gt;&lt;li&gt;Endpoint is unavailable&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Bad request (4xx + error)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;User skips input validation and parameters are rejected&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Request creation fails&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;li&gt;Configuration (CORS, Auth)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Status changes to MALFORMED&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Server error (5xx)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="680" y="640" width="230" height="200" as="geometry" />
