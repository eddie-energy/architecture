          </mxGeometry>
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-30" value="Please note that this is the &quot;glue&quot; to compensate for the &quot;national specificities&quot; that are a bit of a hurdle for such a CM reference process. We have other issues in other MS, that can often be improved with &quot;quick wins&quot; (like this). The project shall help to identify and already implement these improvements.&lt;br&gt;&lt;br&gt;Additionaly, we should provide more detailed instructions for the user here as reference information." style="strokeWidth=1;shadow=0;dashed=0;align=left;html=1;shape=mxgraph.mockup.text.stickyNote2;fontColor=#666666;mainText=;fontSize=22;whiteSpace=wrap;fillColor=#ffffcc;strokeColor=#F62E00;spacing=42;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
