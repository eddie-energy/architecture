@startuml get-historical-data-austria
'sequence diagram
caption Sequence Diagram: The Regional Connector of Austria gets the historical data of the customer

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Customer" as user
box "EDDIE Framework" #transparent
  ' participant "Permission\nFacade" as website
  box "Interoperable Communication\n"  #transparent
    box "Regional Connector - Austria"  #transparent
      participant "Microfrontend" as microfrontend
      participant "Translation\nService" as translationService
      participant "Ponton\nAdapter" as pontonAdapter
      participant "Ponton XP\nMessenger" as pontonXP
    end box
      participant "Message\nProducer" as messageProducer
  end box
end box
box "Regional Data-sharing\nInfrastructure" #transparent
  box "EDA" #transparent
    participant "Consent\nAdmin Portal" as adminPortal
  end box
  box "DSO" #transparent
    participant "Meter Data\nPortal" as dataPortal
  end box
end box

microfrontend -> user : show(redirection)
user -> adminPortal : login(credentials)
user -> adminPortal : approve(consentRequest)
activate adminPortal
adminPortal -> pontonXP : CCM approved
deactivate adminPortal
activate pontonXP
pontonXP -> pontonAdapter : CCM approved
deactivate pontonXP
activate pontonAdapter
pontonAdapter -> microfrontend : CCM approved
deactivate pontonAdapter
activate microfrontend
microfrontend -> user : show(\nconsentStatus)
deactivate microfrontend

adminPortal -> dataPortal : get(data)
activate dataPortal
  dataPortal -->> adminPortal : data
deactivate dataPortal
adminPortal -> pontonXP : send(data)

pontonXP -> pontonAdapter : send(data)
pontonAdapter -> messageProducer : send(data)



@enduml