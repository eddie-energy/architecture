        <mxCell id="BDpJgZSzPQk0G1ojM0ah-25" value="&lt;h1&gt;&lt;font&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;u&gt;Requested Data:&amp;nbsp;&lt;/u&gt;&lt;/font&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;font-size: 18px&quot;&gt;&amp;nbsp; &amp;nbsp;Data Class: &lt;span style=&quot;font-weight: normal&quot;&gt;Validated Historical Consumption Data&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&amp;nbsp; &amp;nbsp;Start Date:&lt;span style=&quot;font-weight: 400&quot;&gt; 2021-01-01&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;End Date: &lt;span style=&quot;font-weight: 400&quot;&gt;2021-12-31&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp;Granularity: &lt;span style=&quot;font-weight: 400&quot;&gt;Half-Hourly&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=20;fontColor=#666666;align=left;verticalAlign=top;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
