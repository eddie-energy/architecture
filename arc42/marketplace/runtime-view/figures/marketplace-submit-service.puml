@startuml marketplace-submit-service

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Eligible Party" as ep
box "Marketplace System" #transparent
  participant "Marketplace \nFrontend" as app
  participant "Marketplace \nBackend" as marketplace
  participant "Database" as database
end box

ep -> app : Request new submission
activate app
app --> ep : Show empty form
ep -> app : Fill out form and submit
app -> marketplace : Forward data
activate marketplace
deactivate app
marketplace -> database : Store data service or data hub
activate database
database -->> marketplace : OK
deactivate database
marketplace -->> app : OK
deactivate marketplace

@enduml