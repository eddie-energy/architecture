        <mxCell id="y7IaNpAsK17leYyvpkBU-5" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;Show loading indicator&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px; text-wrap: nowrap;&quot;&gt;between&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px; text-wrap: nowrap;&quot;&gt;VALIDATED and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap; font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;SENT_TO_PA.&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap; font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: nowrap; font-size: 11px;&quot;&gt;⧗&lt;/span&gt;&lt;/div&gt;" style="shape=note;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2100" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-6" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;Show loading indicator&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px; text-wrap: nowrap;&quot;&gt;between&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px; text-wrap: nowrap;&quot;&gt;VALIDATED and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap; font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;SENT_TO_PA.&lt;/span&gt;&lt;span style=&quot;text-wrap: nowrap; font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; text-wrap: nowrap; font-size: 11px;&quot;&gt;⧗&lt;/span&gt;&lt;/div&gt;" style="shape=note;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1490" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-8" value="No back navigation on result pages. There is no action to take on a previous page that would&amp;nbsp;&lt;i&gt;modify&lt;/i&gt;&amp;nbsp;the permission request." style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1300" y="190" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-10" value="The end user can skip the result page by closing the page before confirming the request at the PA portal.&lt;br&gt;&lt;br&gt;They will have legally accepted the request and should be informed about the result by notification (email)." style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1300" y="60" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-11" value="RCs should show a loading indicator&amp;nbsp;between&amp;nbsp;VALIDATED and&amp;nbsp;SENT_TO_PA.&amp;nbsp;⧗" style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1010" y="130" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-14" value="We might want to remove back navigation after CREATED." style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1000" y="70" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="y7IaNpAsK17leYyvpkBU-15" value="Unlike MALFORMED, INVALID is not an user error and likely not resolvable." style="shape=note;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;whiteSpace=wrap;html=1;" parent="1" vertex="1">
