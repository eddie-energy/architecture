@startuml deployment-diagram-level-1
'deployment diagram
caption Deployment Diagram: Level 1 view

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam actor{
  BorderColor black
  BackgroundColor transparent
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

node "Eligible Party Infrastructure" as epInfra{
  node "Docker Runtime" <<Local Computing Infrastructure>> as local {    
    artifact "Consent \nFacade" as consentFacade
    artifact "Data \nBroker " as broker
    database "Database\n" as database
    artifact "Admin \nConsole" as adminConsole
    artifact "\t\t\t    Interoperable Communication\t\t\t\t" as comm
  }
  node "Docker Runtime" <<Cloud Computing Infrastructure>> as cloud{
    artifact "User Interface \n(Website or App)" as ui
    artifact "Services" as services
  }

  ui -down- consentFacade
  ui -[hidden]right- services
  consentFacade -right- broker
  broker -right- database
  broker -down- comm
  database -right-adminConsole
  broker -up- services
  adminConsole -down- comm

}
node "In-house Infrastructure" {
  node "Docker Runtime" <<In-house Infrastructure>> as house{
    artifact "\t\tAIIDA\t\t" as aiida
  }
  node " " <<Smart Meter>> as meter {
      interface "P1" as p1
      rectangle "dummy" as dummy
  }
  p1 -[hidden] dummy
  aiida -down-( p1 : "\t"
}

node " " <<Regional Data-Sharing Infrastructure>> as energyProvider {
  interface "Meter Data\nPortal" as dataPortal
  interface "Consent Admin\nPortal" as adminPortal
}

actor "Consumer" as consumer
actor "EP Admin" as admin
  admin -left- adminConsole

consumer ---- aiida
consumer - ui

comm -down-( dataPortal
comm -down-( adminPortal
consentFacade -down- comm

aiida -up- comm


@enduml