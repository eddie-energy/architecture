        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-357" value="ACCEPTED" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="2060" y="1790" width="100" height="30" as="geometry" />
        </mxCell>
