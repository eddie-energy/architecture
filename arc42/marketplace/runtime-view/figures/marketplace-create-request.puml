@startuml marketplace-create-request

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Eligible Party" as ep
box "Marketplace System" #transparent
  participant "EP Web App" as app
  participant "Marketplace \nApplication" as marketplace
  participant "Database" as database
end box

ep -> app : Fill out form
app -> marketplace : Submit form
activate marketplace
marketplace -> database : Store \nrequest/service
activate database
database -->> marketplace : OK
deactivate database
marketplace -->> app : OK
deactivate marketplace

@enduml