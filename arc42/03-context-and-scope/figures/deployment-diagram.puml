@startuml deployment-diagram
'deployment diagram
caption Deployment Diagram: High-level view of the system

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam component{
  BorderColor black
  BackgroundColor transparent
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam node{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle {
  borderColor Transparent
  backgroundColor Transparent
  fontColor Transparent
  stereotypeFontColor Transparent
}

node "\t\t\tDocker Runtime\t\t\t" <<Eligible Party Infrastructure>> as epInfra{
  artifact "\t\t Framework\t\t" as eddie
  artifact "Services" as service
  interface "\t\tKafka" as eddie1
  interface "\t\tKafka" as eddie2

  eddie -up- eddie1
  service -down-( eddie1 :Consume historical\nand real-time data
  eddie -right- eddie2
}
node "In-house Infrastructure"  {
node "Docker Runtime" <<In-house Device>> as house{
  artifact "\tAIIDA\t" as aiida
}
node " " <<Smart Meter>> as meter{
  interface "P1" as p1
}
}

node "Regional Data Sharing\nInfrastructure"  as energyProvider {
  interface "API" as energy1
}

' actor "Consumer" as consumer
' actor "Eligible\nParty" as ep

aiida --( p1 :Get real-time data\n

eddie -down--( energy1 :Get historical data
aiida -up--( eddie2 :Send real-time data\n\n

' consumer -down- aiida
' ep -down- eddie

@enduml