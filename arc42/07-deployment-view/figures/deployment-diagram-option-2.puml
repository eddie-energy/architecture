@startuml deployment-diagram-option-2
'deployment diagram
caption Deployment Diagram: Level 2 view, option 2

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam actor{
  BorderColor black
  BackgroundColor transparent
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

  node "Docker Runtime" <<Local Computing Infrastructure>> as local {    
    artifact "Consent\nFacade" as consentFacade
    artifact "Interoperable\nCommunication" as comm
    artifact "Admin\nConsole" as adminConsole
  }
  node "Docker Runtime" <<Organization Computing Infrastructure>> as org {    
    artifact "Data\nBroker " as broker
    database "Database\n" as database
  }

  consentFacade -right- comm
  adminConsole -left- comm
  consentFacade -down- broker
  database -left- broker
  comm -down- broker
  adminConsole -down- database

@enduml