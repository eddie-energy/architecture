@startuml deployment-diagram-option-1
'deployment diagram
caption Deployment Diagram: Level 2 view, option 1

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam component{
  BorderColor black
  BackgroundColor transparent
}
skinparam actor{
  BorderColor black
  BackgroundColor transparent
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

  node "Docker Runtime" <<Local Computing Infrastructure>> as local {    
    component "Consent\nFacade" as consentFacade
    component "Interoperable\nCommunication" as comm
    component "Admin\nConsole" as adminConsole
    artifact "Streaming\nInfrastructure" <<Container>> as broker
    database "Database\n" <<Container>> as database
  }
  consentFacade -right- comm
  adminConsole -left- comm
  consentFacade -down- broker
  database -left- broker
  comm -down- broker
  adminConsole -down- database
  
@enduml