@startuml aiida_deployment_view
'component diagram
caption Component Diagram: Level 2 view

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam artifact{
  BorderColor black
  BackgroundColor transparent
}
skinparam actor{
  BorderColor black
  BackgroundColor transparent
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam collections{
  BorderColor black
  BackgroundColor white
}
skinparam rectangle{
  ' BorderColor transparent
  BackgroundColor transparent
  FontColor black
}


frame "Eligible Party Infrastructure"  as epInfra{
  rectangle "EDDIE Framework" {

    rectangle "EDDIE \nCore" as eddie
    rectangle "AIIDA Regional\nConnector" as regcon
  }
    rectangle "EMQX MQTT Broker" as broker
  rectangle "EMQX IAM DB" as emqxiam


  eddie -[hidden]down- emqxiam
  eddie -[hidden]down- broker
  emqxiam -left- broker
 
}
rectangle "Local Network" {
  rectangle "Smartphone" as smartphone{
    rectangle "Smartphone App" as app

  }
  rectangle "AIIDA Device" as aiida {
    rectangle "Embedded App\n AIIDA Firmware" as embapp
    rectangle "NanoMQ MQTT Broker" as nano
    rectangle "TimescaleDB" as db
  }
  embapp -[hidden]down- nano
  nano -[hidden]down- db
  aiida -[hidden]up- smartphone
  embapp -up- app:DNS
  embapp -down- db
  embapp -left- broker
 
}

frame "Device Italy" as device1
frame "Device Austria" as device2
frame "Device France" as device3

frame "Smart Meter" as smartmeter1
frame "Enedis" as enedis
frame "Smart Meter" as smartmeter2

device1 -left- smartmeter1:\n\nPhysical\ninterfaces
device2 -left- smartmeter2:\n\nPhysical\ninterfaces
device3 -left- enedis:\nTIC\n(2-wire)

regcon -left- embapp:HTTP/MQTT
embapp -[hidden]right- device2
embapp -right- device1:USB
embapp -right- device3:Modbus TCP
nano -right- device2:MQTT
nano -up-embapp
device1 -[hidden]down- device2
device2 -[hidden]down- device3
epInfra -[hidden]right- aiida
enedis -[hidden]left-device3



 

@enduml