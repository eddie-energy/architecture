          <mxGeometry x="820" y="2250" width="280.5" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-594" value="AIIDA&amp;nbsp;🤖" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="2810" width="120" height="30" as="geometry" />
        </mxCell>
