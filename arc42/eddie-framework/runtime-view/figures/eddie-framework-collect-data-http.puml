@startuml eddie-framework-collect-data-http

skinparam style strictuml
skinparam sequence {
  ParticipantBackgroundColor transparent
  ActorBackgroundColor transparent
}

autonumber
!pragma teoz true

actor "Eligible Party" as ep

box "EP Infrastructure" #transparent
  participant "EP HTTP Client" as httpClient
end box

box "EDDIE Framework" #transparent
  participant "EDDIE Core" as eddie
  participant "Region Connector" as rc
  participant "Outbound Connector" as restOC
  participant "Database" as db
end box

== Data Retrieval ==
rc -> rc : Collect \ncustomer data \nfrom regional \ndata source
rc -> eddie : Send collected data
activate eddie
eddie -> restOC : Forward collected data
restOC -> db : Store data \ntemporarily
restOC -> eddie : Make data available\nvia HTTP endpoint
deactivate eddie

== Data Access ==
ep -> httpClient : Request data
httpClient -> restOC : Send GET requests to the REST endpoint
restOC -->> ep : Return customer data

@enduml
