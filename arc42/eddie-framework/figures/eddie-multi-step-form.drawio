        <mxCell id="9nYys6eHMbZARxnZalG5-167" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="9nYys6eHMbZARxnZalG5-162" target="9nYys6eHMbZARxnZalG5-161" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-162" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="822.5" y="-250" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-189" value="&lt;div&gt;This is likely caused by one of the following:&lt;/div&gt;1. There is a network issue on the server.&lt;div&gt;2. The PA is unreachable (Ponton down for EDA).&lt;/div&gt;&lt;div&gt;3. The RC is configured incorrectly.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="602.5" y="-130" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-190" value="The end user likely skipped the browser input validation." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="330" y="-90" width="185" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-193" value="The user did not react to the request in a timely manner. EP configures duration." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1042.5" y="-230" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-194" value="&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;The request was faulty despite our validation. Either we were unable to validate a user input, the PA decided that they cannot handle the request, or the PA API changed.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Sent immediately without user interaction.&lt;/span&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1042.5" y="-170" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-195" value="The user rejected the request at the PA portal." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1042.5" y="-290" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-196" value="UNFULFILLABLE" style="whiteSpace=wrap;html=1;fillColor=#FFCCCC;" parent="1" vertex="1">
          <mxGeometry x="1142.5" y="-340" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-200" value="Some RCs will send this state almost immediately and we can inform the end user accordingly." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1292.5" y="-350" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-212" value="Request was validated by us and can be sent to the PA." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="640" y="-310" width="185" height="50" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-213" value="For RCs implementing callback pages (Enedis, Mijn, Green Button) the status will not change from VALIDATED to SENT_TO_PA immediately. The status changes once the user lands on the callback page." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="192.5" y="-340" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-243" value="Enedis&amp;nbsp;🇫🇷" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="2250" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-244" value="EDA&amp;nbsp;🇦🇹" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="40" y="1210" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-289" value="Datadis&amp;nbsp;🇪🇸" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="41.5" y="1730" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-318" value="While the user &lt;i&gt;can&lt;/i&gt; answer incorrectly, it has minimal impact.&lt;div&gt;&lt;br&gt;&lt;div&gt;If they click &quot;Accepted&quot; when they did not accept the request, the status will change to UNFULFILLABLE since we cannot retrieve data.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If they click &quot;Rejected&quot; when they accepted the request, we will not retrieve any data.&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1940" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-343" value="Mijn&amp;nbsp;🇳🇱" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="430" y="2250" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-347" value="Automated" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1720" y="1210" width="160" height="30" as="geometry" />
