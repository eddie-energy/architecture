        <mxCell id="BDpJgZSzPQk0G1ojM0ah-8" value="(grayed out because only 1 CA in ES)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#666666;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="740" y="271" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-9" value="&lt;h1&gt;&lt;font&gt;&lt;font style=&quot;font-size: 24px&quot;&gt;&lt;u&gt;Requested Data:&amp;nbsp;&lt;/u&gt;&lt;/font&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h1 style=&quot;font-size: 18px&quot;&gt;&amp;nbsp; &amp;nbsp;Data Class: &lt;span style=&quot;font-weight: normal&quot;&gt;Validated Historical Consumption Data&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&amp;nbsp; &amp;nbsp;Start Date:&lt;span style=&quot;font-weight: 400&quot;&gt; 2021-01-01&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/span&gt;End Date: &lt;span style=&quot;font-weight: 400&quot;&gt;2021-12-31&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp;Granularity: &lt;span style=&quot;font-weight: 400&quot;&gt;Half-Hourly&lt;/span&gt;&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=20;fontColor=#666666;align=left;verticalAlign=top;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="200" y="320" width="760" height="180" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-11" value="Proceed to Datadis..." style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.buttons.button;strokeColor=#666666;fontColor=#ffffff;mainText=;buttonStyle=round;fontSize=17;fontStyle=1;fillColor=#008cff;whiteSpace=wrap;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="870" y="710" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-12" value="&lt;b&gt;IMPORTANT:&lt;/b&gt; In Spain, at the moment it is not possible to get the information back, which &lt;i&gt;Metering Point&lt;/i&gt;&amp;nbsp;has been selected for the consent. As &lt;i&gt;Comparor&lt;/i&gt;&amp;nbsp;will need to request that data once per day, it needs that information. Please provide it below:" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;spacingTop=10;spacingLeft=10;spacingBottom=10;spacingRight=10;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="200" y="500" width="890" height="100" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-13" value="Shared Metering Point ID:" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#666666;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="200" y="660" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=20;fontColor=#666666;" parent="C6W2u3O-N2q2SRVX3129-1" source="BDpJgZSzPQk0G1ojM0ah-14" target="BDpJgZSzPQk0G1ojM0ah-12" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1390" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="BDpJgZSzPQk0G1ojM0ah-14" value="Please note that this is the &quot;glue&quot; to compensate for the &quot;national specificities&quot; that are a bit of a hurdle for such a CM reference process. We have other issues in other MS, that can often be improved with &quot;quick wins&quot; (like this). The project shall help to identify and already implement these improvements.&lt;br&gt;&lt;br&gt;Additionaly, we should provide more detailed instructions for the user here as reference information." style="strokeWidth=1;shadow=0;dashed=0;align=left;html=1;shape=mxgraph.mockup.text.stickyNote2;fontColor=#666666;mainText=;fontSize=22;whiteSpace=wrap;fillColor=#ffffcc;strokeColor=#F62E00;spacing=42;" parent="C6W2u3O-N2q2SRVX3129-1" vertex="1">
          <mxGeometry x="1180" y="50" width="700" height="440" as="geometry" />
        </mxCell>
