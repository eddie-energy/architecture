        </mxCell>
        <mxCell id="cABAZdG-4c3w-i0kzepM-1265" value="Browser input validation should minimize the risk of validation errors." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
