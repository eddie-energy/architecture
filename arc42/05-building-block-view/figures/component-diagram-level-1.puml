@startuml component-diagram-level-1
'component diagram
caption Component Diagram: Level 1 view

skinparam linetype ortho
skinparam interface {
  backgroundColor transparent
  borderColor black
}
skinparam component{
  BorderColor black
  BackgroundColor transparent
}
skinparam actor{
  BorderColor black
  BackgroundColor transparent
}
skinparam database{
  BorderColor black
  BackgroundColor transparent
}
skinparam rectangle{
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}



node "Eligible Party Infrastructure"  as epInfra{
  component "\t\tEDDIE Framework\t\t\n" as eddie
  component "User Interface \n(Website or App)" as ui
  component "Services" as services

  ui -down- eddie
  ui -[hidden]right- services
  services -down- eddie
}

node "In-house\nInfrastructure" {
  component "\tAIIDA\t" as aiida
  node "Smart Meter" as meter {
      interface "Smart Meter\nInterface" as p1
  }
  aiida -down-( p1 
}

node "Regional Data-sharing\nInfrastructure" as energyProvider {
  interface "Meter\nData\nPortal" as dataPortal
  interface "Consent\nAdmin\nPortal" as adminPortal
}

actor "Consumer" as consumer
actor "Eligible Party" as admin

admin -left- eddie
consumer -left- ui
consumer -down- aiida

eddie -down-( adminPortal
eddie -down-( dataPortal
eddie -down- aiida

@enduml