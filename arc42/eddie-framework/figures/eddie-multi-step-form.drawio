        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-360" value="SENT_TO_PA" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="1950" y="2310" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-361" value="ACCEPTED" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="2060" y="2310" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-362" value="" style="endArrow=none;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="2050" y="1830" as="sourcePoint" />
            <mxPoint x="2050" y="1780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-363" value="" style="endArrow=none;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1939.67" y="2350" as="sourcePoint" />
            <mxPoint x="1939.67" y="2300" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-366" value="EDA, Energinet" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1240" width="430" height="20" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-367" value="Datadis, Fingrid" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1760" width="430" height="20" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-368" value="Enedis, Mijn, Green Button" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2280" width="430" height="20" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-369" value="The user is redirected to the PA portal if the request was validated, but the request is not sent to the PA.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The request status becomes SEND_TO_PA (and almost immediately ACCEPTED) once the user lands on the callback page with valid query parameters.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;There is no step 4 with additional instructions and the user lands on the last step instead.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2370" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-371" value="1. The user inputs all relevant data in the EDDIE popup and the request is sent to the PA.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. The user is instructed to confirm the permission request in the PA portal.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. The user is shown a result page depending on if they approved or rejected the request. If the permission was already given, it is accepted immediatly.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1330" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-372" value="The request is sent to the PA as usual, but the PA does not inform us on the action of the user.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The user reports if they accepted or rejected the request.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1720" y="1850" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-373" value="Usually implemented for RCs that require an OAuth flow." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="1720" y="2530" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-397" value="Fingrid&amp;nbsp;🇫🇮" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="741.5" y="1730" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9nYys6eHMbZARxnZalG5-400" value="Request are CREATED when they pass our browser and API validation." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=11;align=left;spacingLeft=10;spacingRight=15;" parent="1" vertex="1">
          <mxGeometry x="40" y="-240" width="185" height="60" as="geometry" />
        </mxCell>
